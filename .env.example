# 复制为 .env 并填入真实值；.env 在 .gitignore 里，不会进仓库
# ----------------------------------------------------------------

# 6551.io（推特抓取）
# 注册申请：https://6551.io/mcp
OPENTWITTER_TOKEN=
OPENTWITTER_BASE_URL=https://ai.6551.io

# Claude（AI 总结）
# 走官方 API 时只填 ANTHROPIC_API_KEY，BASE_URL 留空
# 走代理时两者都填，BASE_URL 必须带 https:// 前缀
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# 模型 ID 默认从 config/settings.yaml 的 ai.model 读取
# 仅当代理服务用别的 ID 时在此覆盖
# ANTHROPIC_MODEL=claude-sonnet-4-6

# 可选：覆盖 SQLite 路径（默认项目根 kol_monitor.db）
# KOL_MONITOR_DB=/var/lib/kol-monitor/kol_monitor.db

# 可选：覆盖媒体目录（默认项目根 media/）
# KOL_MONITOR_MEDIA_DIR=/var/lib/kol-monitor/media
