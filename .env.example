# 复制为 .env 并填入真实值；.env 和 .env.local 在 .gitignore 里，不会进仓库
# ----------------------------------------------------------------

# 6551.io（推特抓取）
# 注册申请：https://6551.io/mcp
OPENTWITTER_TOKEN=
OPENTWITTER_BASE_URL=https://ai.6551.io

# DeepSeek（AI 总结首选）
# 官方 Anthropic-compatible 接口；正常只需填 API key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=max

# Claude（DeepSeek 失败时的降级备用）
# 走官方 API 时只填 ANTHROPIC_API_KEY，BASE_URL 留空
# 走代理时两者都填，BASE_URL 必须带 https:// 前缀
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# 可选：Claude 降级链的第一顺位
ANTHROPIC_FALLBACK_API_KEY=
ANTHROPIC_FALLBACK_BASE_URL=

# 可选：Claude 降级链的第三顺位
# BASE_URL 填服务根地址即可，不需要追加 /v1
ANTHROPIC_THIRD_API_KEY=
ANTHROPIC_THIRD_BASE_URL=
ANTHROPIC_THIRD_MODEL=anthropic/claude-sonnet-4.6

# 可选：Claude 降级链的第二顺位（环境变量名为历史遗留）
# BASE_URL 填服务根地址即可，不需要追加 /v1
ANTHROPIC_FOURTH_API_KEY=
ANTHROPIC_FOURTH_BASE_URL=
ANTHROPIC_FOURTH_MODEL=claude-sonnet-4-6

# 模型 ID 默认从 config/settings.yaml 的 ai.model 读取
# 仅当代理服务用别的 ID 时在此覆盖
# ANTHROPIC_MODEL=claude-sonnet-4-6

# 可选：覆盖 SQLite 路径（默认项目根 kol_monitor.db）
# KOL_MONITOR_DB=/var/lib/kol-monitor/kol_monitor.db

# 可选：覆盖媒体目录（默认项目根 media/）
# KOL_MONITOR_MEDIA_DIR=/var/lib/kol-monitor/media

# 可选：把每期最终 Markdown 同步到本地数据归档；为空则不额外归档
# KOL_MONITOR_DIGEST_ARCHIVE_DIR=/var/lib/kol-monitor/digests

# 发布安全开关
# 默认不执行远端 git push，公开 clone 后直接运行不会推送到原仓库。
# 确认 origin 是你自己的仓库并希望自动发布时，再在 .env.local 里设为 true。
KOL_MONITOR_ALLOW_PUSH=false
